{
  "name": "relay-backport",
  "version": "0.2.1",
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "typescript": "^5.6.0"
  },
  "bin": {
    "relay-backport": "./src/cli.ts"
  },
  "description": "An ACP harness that hands Buzz mentions to tools with no Buzz integration — Claude Code terminals, webhooks, shell hooks. Buzz owns the relay; relay-backport owns delivery.",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "start": "bun run src/cli.ts acp",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun run build:linux && bun run build:darwin && bun run build:windows",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/cli.ts --outfile dist/relay-backport-linux-x64",
    "build:darwin": "bun build --compile --target=bun-darwin-arm64 src/cli.ts --outfile dist/relay-backport-darwin-arm64",
    "build:windows": "bun build --compile --target=bun-windows-x64 src/cli.ts --outfile dist/relay-backport-windows-x64.exe"
  },
  "type": "module"
}
