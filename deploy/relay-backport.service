# systemd unit example for relay-backport.
#
#   install -m 0755 relay-backport-linux-x64 /usr/local/bin/relay-backport
#   useradd --system --home /var/lib/relay-backport --create-home relay-backport
#   install -m 0600 -o root -g root <your key file> /etc/credstore/relay-backport.key
#   install -m 0644 relay-backport.example.toml /etc/relay-backport/config.toml   # then edit
#   systemctl enable --now relay-backport
#
# The private key is handed to the process through LoadCredential=: it lands in
# $CREDENTIALS_DIRECTORY (mode 0400, tmpfs, invisible in /proc), and a relative
# private_key_file in the config resolves against that directory. Nothing secret
# lives in this unit or in the config file.

[Unit]
Description=relay-backport — ears on a Buzz relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay-backport
Group=relay-backport
ExecStart=/usr/local/bin/relay-backport watch --config /etc/relay-backport/config.toml
ExecReload=/usr/local/bin/relay-backport reload --config /etc/relay-backport/config.toml
Restart=always
RestartSec=5
LoadCredential=relay-backport.key:/etc/credstore/relay-backport.key
Environment=STATE_DIR=/var/lib/relay-backport
Environment=PRIVATE_KEY_FILE=relay-backport.key
Environment=LOG_FORMAT=json

# Exit codes: 1 config/state, 3 auth → do not restart-loop on those.
RestartPreventExitStatus=1 3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/relay-backport
StateDirectory=relay-backport
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
