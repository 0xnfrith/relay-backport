# relay-backport — environment overrides (every key is optional; the config
# file carries the same settings). Placeholders only. Never commit real values.
#
# Every variable is prefixed RELAY_BACKPORT_ so it can never collide with what
# the Buzz harness injects (BUZZ_RELAY_URL, BUZZ_PRIVATE_KEY, BUZZ_AUTH_TAG).
# Those are Buzz's: relay-backport needs none of them.

# Config file (TOML or JSON).
RELAY_BACKPORT_CONFIG=

# Where the default delivery file lives. Defaults to the per-user state dir.
RELAY_BACKPORT_STATE_DIR=

# Comma-separated list: file, webhook, exec. Default: file.
RELAY_BACKPORT_SINKS=file

# The delivery file (default <state dir>/deliveries.jsonl); `relay-backport tail` follows it.
RELAY_BACKPORT_FILE=

# How long a turn waits for the sinks before ending anyway (ms).
RELAY_BACKPORT_DELIVERY_WAIT_MS=15000

# text | json (stderr)
RELAY_BACKPORT_LOG_FORMAT=text

# webhook sink
RELAY_BACKPORT_WEBHOOK_URL=https://hooks.example.com/relay-backport
RELAY_BACKPORT_WEBHOOK_BEARER_FILE=/etc/credstore/relay-backport-webhook.token
RELAY_BACKPORT_WEBHOOK_TIMEOUT_MS=8000
RELAY_BACKPORT_WEBHOOK_ATTEMPTS=3

# exec sink (whitespace-split; use the config file for arguments with spaces)
RELAY_BACKPORT_EXEC_COMMAND=/usr/local/bin/handle-mention
RELAY_BACKPORT_EXEC_TIMEOUT_MS=60000
# true = hand BUZZ_* (relay URL, key, auth tag) to the hook so it can call the buzz CLI
RELAY_BACKPORT_EXEC_PASS_BUZZ_ENV=false
