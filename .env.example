# relay-backport — environment overrides (every key is optional; the config
# file carries the same settings). Placeholders only. Never commit real values.
#
# Every variable is prefixed RELAY_BACKPORT_ so it can never collide with what
# the Buzz harness injects (BUZZ_RELAY_URL, BUZZ_PRIVATE_KEY, BUZZ_AUTH_TAG).
# Those are Buzz's: relay-backport needs none of them.

# Config file (TOML or JSON).
RELAY_BACKPORT_CONFIG=

# Where the default delivery file lives. Defaults to the per-user state dir.
RELAY_BACKPORT_STATE_DIR=

# Comma-separated list: file, webhook, exec. Default: file.
RELAY_BACKPORT_SINKS=file

# The delivery file (default <state dir>/deliveries.jsonl); `relay-backport tail` follows it.
RELAY_BACKPORT_FILE=

# Write the session's system prompt once to <state dir>/sessions/<id>.system-prompt.md
# and name it in the EVENT|session|new|... line. Default: true.
RELAY_BACKPORT_FILE_SYSTEM_PROMPT=true

# Path to (re)write the harness-injected BUZZ_* identity to on every session/new
# (KEY=value lines; only the vars present). Holds the agent's private key — off
# by default; only set this for a consumer that must act as the agent.
RELAY_BACKPORT_FILE_BUZZ_ENV_FILE=

# How long a turn waits for the sinks before ending anyway (ms).
RELAY_BACKPORT_DELIVERY_WAIT_MS=15000

# text | json (stderr)
RELAY_BACKPORT_LOG_FORMAT=text

# webhook sink
RELAY_BACKPORT_WEBHOOK_URL=https://hooks.example.com/relay-backport
RELAY_BACKPORT_WEBHOOK_BEARER_FILE=/etc/credstore/relay-backport-webhook.token
RELAY_BACKPORT_WEBHOOK_TIMEOUT_MS=8000
RELAY_BACKPORT_WEBHOOK_ATTEMPTS=3
# Attach the session's system prompt (verbatim, ~20-40 KB) to every POST. Default: true.
RELAY_BACKPORT_WEBHOOK_INCLUDE_SYSTEM_PROMPT=true

# exec sink (whitespace-split; use the config file for arguments with spaces)
RELAY_BACKPORT_EXEC_COMMAND=/usr/local/bin/handle-mention
RELAY_BACKPORT_EXEC_TIMEOUT_MS=60000
# true = hand BUZZ_* (relay URL, key, auth tag) to the hook so it can call the buzz CLI
RELAY_BACKPORT_EXEC_PASS_BUZZ_ENV=false
# Attach the session's system prompt (verbatim) to the stdin JSON. Default: false.
RELAY_BACKPORT_EXEC_INCLUDE_SYSTEM_PROMPT=false

# Append prompt-header words to the MENTION| JSON. Default: false.
# RELAY_BACKPORT_FILE_PROMPT_FIELDS=false

# Named tail view. Default: raw (the stored line).
# RELAY_BACKPORT_VIEW=claude-code
# RELAY_BACKPORT_VIEW_VISIBLE_CHARS=500
# RELAY_BACKPORT_VIEW_HIDE=

# `relay-backport run` — exactly one key source. The command form is an argv
# (whitespace-split); stdout is the key, stderr is discarded, and --dry-run does not run it.
# RELAY_BACKPORT_RUN_KEY_FILE=/etc/relay-backport/agent.key
# RELAY_BACKPORT_RUN_KEY_COMMAND=op read op://vault/item/credential

# Delivery receipt (kind:7 on the wake). Off by default.
# RELAY_BACKPORT_RECEIPT_ENABLED=true
# RELAY_BACKPORT_RECEIPT_REACTION=👀
# RELAY_BACKPORT_RECEIPT_TIMEOUT_MS=4000
# RELAY_BACKPORT_RECEIPT_MAX_SEEN=5000
